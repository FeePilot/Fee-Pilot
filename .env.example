# ─────────────────────────────────────────────────────────────────────────────
# FeePilot configuration
#
#   cp .env.example .env     # then edit .env (it is git-ignored; this file is the template)
#   set -a; . ./.env; set +a # export it into your shell before `cargo run`
#
# Lines that start with "#" are optional and show the default or an example.
# Lines without "#" are the settings you need for a first run on regtest.
# ─────────────────────────────────────────────────────────────────────────────

# ── API server ───────────────────────────────────────────────────────────────
# Address the API listens on. Keep it on loopback unless a reverse proxy fronts it.
FEEPILOT_BIND=127.0.0.1:8080

# What the API serves at "/" (unset = API only):
#   web            the original static UI (default, unchanged)
#   frontend/dist   the React app after `pnpm build` in frontend/
FEEPILOT_WEB_DIR=web

# Log filter (tracing-subscriber syntax).
RUST_LOG=info,feepilot=debug

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Start one locally with: docker compose up -d postgres
DATABASE_URL=postgres://feepilot:feepilot@localhost:5432/feepilot

# ── Bitcoin Core ─────────────────────────────────────────────────────────────
# One of: regtest | signet | testnet | mainnet. Every snapshot and job carries its network.
FEEPILOT_NETWORK=regtest
# RPC ports: regtest 18443, signet 38332, testnet 18332, mainnet 8332 (Polar uses its own).
BITCOIN_RPC_URL=http://127.0.0.1:18443
# Use a dedicated, least-privilege RPC user, and change this password.
BITCOIN_RPC_USER=feepilot
BITCOIN_RPC_PASS=change-me
# sat/vB used when the node has no fee estimate (regtest never has one).
# LEAVE UNSET on signet, testnet and mainnet so a missing estimate shows as "none".
FEEPILOT_FALLBACK_FEE_RATE=20

# ── Fee snapshots from a public API (optional) ───────────────────────────────
# Lets you read fee estimates without running a node for that network (e.g. signet).
# Only the fee snapshot comes from here; analysis and PSBTs still need the node above.
# Estimates are labelled "third_party", the fallback rate is not applied to them, and the
# URL must match FEEPILOT_NETWORK (FeePilot cannot check that for you).
#   esplora       Blockstream:   https://blockstream.info/signet/api
#   mempool_space mempool.space: https://mempool.space/signet/api
# FEEPILOT_FEE_API_URL=https://blockstream.info/signet/api
# FEEPILOT_FEE_API_KIND=esplora

# ── Offline fee advisor ──────────────────────────────────────────────────────
# Snapshot age in seconds. Up to FRESH it is "recent"; up to STALE it is "past the window";
# older is "very stale". Clients apply these windows offline too. STALE must be >= FRESH.
# FEEPILOT_FRESH_SECS=600
# FEEPILOT_STALE_SECS=3600
# A fee refresh within this many seconds of the last good snapshot is answered from the
# cache, so clients cannot make the node work on every request. 0 = always ask the node.
# FEEPILOT_FEE_REFRESH_MIN_SECS=10

# ── Abuse limits ─────────────────────────────────────────────────────────────
# Requests per minute per client address on /v1 and /v2 (0 = off). Behind a reverse proxy
# every client shares the proxy's address, so rate-limit at the proxy as well.
# FEEPILOT_RATE_LIMIT_PER_MIN=120

# ── Tracker (the background worker) ──────────────────────────────────────────
# How often active jobs are checked against the node.
FEEPILOT_TRACK_INTERVAL_SECS=30
# Confirmations after which a job is "settled" and no longer watched.
FEEPILOT_SETTLE_DEPTH=6
# POST a JSON event here whenever a job changes state (best effort: one attempt, no retries).
# FEEPILOT_WEBHOOK_URL=https://example.com/feepilot-hook

# ── Retention ────────────────────────────────────────────────────────────────
# The tracker deletes fee history, order notes and finished (settled/obsolete) jobs older
# than this many days, hourly. The newest good snapshot per network and any unfinished job
# are always kept. 0 = keep everything.
# FEEPILOT_RETENTION_DAYS=30

# ── Web app build (frontend/, read by Vite at build time) ─────────────────────
# Only variables that start with VITE_ reach the browser. Never put a secret in one.
#
# The public origin, e.g. https://feepilot.example. Needed for canonical URLs, Open Graph
# tags and sitemap.xml. Without it those are left out rather than pointing at a made-up domain.
# VITE_SITE_URL=https://feepilot.example
# Prefix for API calls. Empty = same origin (the API serves the app), which is what you want.
# VITE_API_BASE=
